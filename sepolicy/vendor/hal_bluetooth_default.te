init_daemon_domain(hal_bluetooth_default)

hal_server_domain(hal_bluetooth_default, hal_bluetooth)

allow hal_bluetooth_default stpbt_device:chr_file rw_file_perms;
allow hal_bluetooth_default self:{ capability2 } { block_suspend };

allow hal_bluetooth_default self:udp_socket create_socket_perms;
allow hal_bluetooth_default self:{ netlink_socket } { create bind read };